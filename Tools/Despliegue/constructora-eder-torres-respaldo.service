[Unit]
Description=Respaldo coordinado de Constructora Eder Torres
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/constructora-eder-torres/respaldo
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/python3 /usr/local/libexec/cet-respaldar.py --base @@BASE@@ --retencion-dias 7
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=35min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/constructora-eder-torres
