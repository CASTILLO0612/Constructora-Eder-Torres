[Unit]
Description=API Constructora Eder Torres
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cet-api
Group=cet-api
WorkingDirectory=/opt/constructora-eder-torres/actual/Api
ExecStart=/usr/bin/dotnet /opt/constructora-eder-torres/actual/Api/ConstructoraEderTorres.Presentacion.dll
EnvironmentFile=/etc/constructora-eder-torres/entorno
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=cet-api
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/constructora-eder-torres/evidencias /var/lib/constructora-eder-torres/claves

[Install]
WantedBy=multi-user.target
